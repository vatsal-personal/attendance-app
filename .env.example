# Copy this file to ".env" and fill in your actual values.
# Never commit your real .env file to version control.

# Full Postgres connection string.
# For Supabase: Project Settings -> Database -> Connection string -> URI
# (use the "Transaction pooler" or "Session pooler" URI if connecting from a
# serverless/short-lived environment; use the direct connection for local dev)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_SUPABASE_HOST:5432/postgres


